        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.137578817458051, 1.2701846871158207, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Robotiq_2F_85" (
            delete apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
            quatd xformOp:orient = (3.090861261951037e-8, -3.0908622798086e-8, 0.7071067811865469, 0.7071067811865469)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.853553727343324, -0.8355909129651726, 0.06280000507831573)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "base_link"
            {
                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </World/ur5e/wrist_3_link>
                    rel physics:body1 = </World/Robotiq_2F_85_edit/Robotiq_2F_85/base_link>
                    point3f physics:localPos0 = (-1.110223e-16, -4.57967e-16, 4.440892e-16)
                    point3f physics:localPos1 = (-2.220446e-16, -9.15934e-16, 8.881784e-16)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
